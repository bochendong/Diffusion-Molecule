  },
  "evaluation": {
    "denovo": "P6 hard",
    "edit": "frozen Table1",
    "raw_candidate_budgets": [1, 8, 20],
    "metrics": ["validity", "strict_success", "identity", "strict_nonidentity", "source_tanimoto"]
  }
