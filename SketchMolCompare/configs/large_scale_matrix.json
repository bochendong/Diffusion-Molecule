      "family": "sketchsmiles_ocr_free",
      "script": "SketchMolCompare/scripts/submit_sketchsmiles_5a4_transformer.sh",
      "purpose": "Best current OCR-free latent/fingerprint conditioned Transformer decoder with condition-fingerprint reranking.",
      "primary_metrics": [
        "top1_exact_match_fraction",
        "topk_exact_match_fraction",
        "top1_target_tanimoto",
        "top1_scaffold_match_fraction",
